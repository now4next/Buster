{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buster",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "nowfornext@naver.com"
    }
  ]
}
